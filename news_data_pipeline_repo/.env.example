# ------------------------------
# LLM Provider selection (gemini, openai, etc)
LLM_PROVIDER=gemini

# ------------------------------
# Database
# ------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nepali_news
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------
# RabbitMQ
# ------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5671
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ------------------------------
# Object Storage (MinIO/S3-compatible)
# ------------------------------
AWS_S3_ENDPOINT=localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=news-raw

# ------------------------------
# Gemini
# ------------------------------
GEMINI_API_KEY=your_key_1
GEMINI_API_KEY_2=your_key_2
GEMINI_API_KEY_3=your_key_3
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_GENERATE_MODEL=gemini-2.0-flash

# ------------------------------
# Logging
# ------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
LOG_DATEFMT=%Y-%m-%d %H:%M:%S
SUPPRESS_INSECURE_REQUEST_WARNING=true

# ------------------------------
# Optional / Not in main pipeline
# ------------------------------
TWITTER_BEARER_TOKEN=
